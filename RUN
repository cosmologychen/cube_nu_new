code_path=/home/cossim/cube_nu/mnus/code
output=/home/cossim/cube_nu/output
flag=''
log_name=''
#### run ####
# RunIC=true
# RunMain=true
# Findhalo=true
OnlyCIC=true
newdir=true

#### set_pbs ####
q='debug'
# q='small'
# q='normal'
ntasks_per_node=1
ncore=64
nnest=4
mem=300

#### set_PP ####
PP=true
PP_corr=true

#### set_cube ####
box=600
M_nu=0.1
checkpoint=1
ng=512
nn=1
Cpk=2

#### input_para ####
if [ ! -z "$1" ]; then
    box=$1
fi
if [ ! -z "$2" ]; then
    M_nu=$2
fi
if [ ! -z "$3" ]; then
    checkpoint=$3
fi
if [ ! -z "$4" ]; then
    ng=$4
fi
if [ ! -z "$5" ]; then
    nn=$5
fi
if [ ! -z "$6" ]; then
    Cpk=$6
fi

if [ $(echo "$M_nu == 0.0" | bc) -eq 1 ]; then
    cpktype='无'
else
    if  [ "$Cpk" = "-1" ]; then
        cpktype='-1 完全使用CAMB'
    elif [ "$Cpk" = "0" ]; then
        cpktype=' 0 部分使用CAMB'
    elif [ "$Cpk" = "1" ]; then
        cpktype=' 1 使用拼接功率谱'
    elif [ "$Cpk" = "2" ]; then
        cpktype=' 2 使用全局功率谱'
    else
        echo -e "${RED}功率谱算法设置错误${NC}"
        exit 1
    fi
fi

if [[ $(echo "$M_nu*1000" | bc | cut -d. -f1) -gt 0 ]];then
    m_nu1=$(echo "scale=16;$M_nu / 3" | bc) && m_nus=($m_nu1 $m_nu1 $m_nu1) #DG
    # m_nus=(0.049 0.051 0.0) #IH
    # m_nus=(0.02168842 0.02335353 0.05495805) #NH
else
    m_nus=(0.0 0.0 0.0)
fi

smnus="${m_nus[0]}"
dmnu=$(echo "$M_nu - ${m_nus[0]}" |bc)
for ((i=1; i<3; i++)); do
    smnus="$smnus,${m_nus[$i]}"
    dmnu=$(echo "scale=3;$dmnu - ${m_nus[$i]}" |bc)
    # echo "$dmnu || $smnus"
done

if [ $(echo "$dmnu%0.0001" | bc -l) -ne 0 ]; then
    echo "dmnu 不等于0"
    exit 1
fi

# if [ $newdir ]; then
#     output=$output
# fi
if [ ! $PP ]; then
    flag='nopp'$flag
else
    if [ ! $PP_corr ]; then
        flag='nocorr'$flag
    fi
fi


if [[ $(echo "${m_nus[0]}*100000" | bc | cut -d. -f1)  -ne $(echo "${m_nus[2]}*100000" | bc | cut -d. -f1) ]]; then
    if [[ $(echo "${m_nus[0]}*100000" | bc | cut -d. -f1) -gt $(echo "${m_nus[2]}*100000" | bc | cut -d. -f1) ]]; then
        flag='IH'$flag
    else
        flag='NH'$flag
    fi
fi
code_path="${code_path/#~\//$HOME/}"
output="${output/#~\//$HOME/}"
opath=$flag$box'_'$ng'_'$nn'_'$M_nu'_'$Cpk
name=$flag$box$((ng*nn))'_'$M_nu'_'$Cpk
nnn=$((nn*nn*nn))
if [ $nn -gt 1 ]; then
    nnode=$((nn*nn*nn/ntasks_per_node))
    nncore=$((ncore/ntasks_per_node))
else
    nnode=$((nnn))
    nncore=$((ncore))
fi
nteam=$((nncore/nnest))

# 颜色定义（确保在脚本开头定义）
RED='\033[31m'; CYAN='\033[36m'; GREEN='\033[32m'; YELLOW='\033[33m'; NC='\033[0m'; MAGENTA='\033[35m'

# ======== 检查点处理逻辑 ========
if [ -n "$RunIC" ]; then
    checkpoint=1
fi
if [ -n "$OnlyCIC" ]; then
    checkpoint=1
fi

if [ "$checkpoint" -ne 1 ]; then
    rawpath=$(pwd)
    echo $rawpath
    cd $code_path/$opath

    if [ "$checkpoint" -ne -1 ]; then
        # ======== 统一文件验证 ========
        target_file="$output/$opath/image1/$(awk -v line=$checkpoint '
            NR==line {
                raw = $1 + 0  
                z_sprintf = sprintf("%.3f", raw)
                sub(/\.$/, ".000", z_sprintf)
                print z_sprintf
                exit
            }' z_checkpoint.txt)_xp_1.bin"

        echo $target_file
        if [ ! -f "$target_file" ]; then
            echo $target_file
            target_file="$output/$opath/image1/$(awk -v line=$checkpoint '
                NR==line {
                    raw =  $1 + 0.001
                    z_sprintf = sprintf("%.3f", raw)
                    sub(/\.$/, ".000", z_sprintf)
                    print z_sprintf
                    exit
                }' z_checkpoint.txt)_xp_1.bin"
            if [ ! -f "$target_file" ]; then
                echo $target_file
                target_file="$output/$opath/image1/$(awk -v line=$checkpoint '
                    NR==line {
                        raw =  $1 - 0.0015
                        z_sprintf = sprintf("%.3f", raw)
                        sub(/\.$/, ".000", z_sprintf)
                        print z_sprintf
                        exit
                    }' z_checkpoint.txt)_xp_1.bin"
                if [ ! -f "$target_file" ]; then
                    checkpoint=-1
                fi
            fi
        fi
    fi

    if [ 1 -gt "$checkpoint" ]; then
        echo -e "${RED}无效检查点...${NC}"
        
        # 验证输出目录存在性
        if [ ! -d "$output/$opath/image1" ]; then
            echo -e "${RED}错误：目录不存在 $output/$opath/image1${NC}"
            exit 1
        fi

        # 获取最新文件（按修改时间倒序）
        latest_file=$(ls -t "$output/$opath/image1"/*_xp_1.bin 2>/dev/null | head -n 1)
        
        if [ -z "$latest_file" ]; then
            echo -e "${RED}错误：找不到任何xp_1.bin文件${NC}"
            echo -e "${YELLOW}可用文件列表："
            ls -halFtr "$output/$opath/image1"/*_xp_1.bin 2>/dev/null || echo "无可用文件"
            exit 1
        fi

        # 从文件名提取红移值（支持小数和科学计数法）
        z_value=$(basename "$latest_file" | grep -oE '^[0-9]+\.?[0-9]*([eE][-+]?[0-9]+)?')
        z_value=$(echo "$z_value=" | awk '{printf "%.3f", $1}')
        
        if [ -z "$z_value" ]; then
            echo -e "${RED}文件名格式错误：${latest_file}${NC}"
            echo -e "预期格式示例：0.123_xp_1.bin"
            exit 1
        fi

        # 反向查找z_checkpoint中的行号
        if [ ! -f "z_checkpoint.txt" ]; then
            echo -e "${RED}错误：z_checkpoint文件不存在${NC}"
            exit 1
        fi

        # 精确匹配红移值（支持科学计数法）
        checkpoint=$(awk -v z="$z_value" -v tolerance=0.001 \
            'BEGIN{FS="[ \t]+"; target=z+0} 
            {current=$1+0; 
            if (current >= target - tolerance && current <= target + tolerance) {
                print NR;
            }}' z_checkpoint.txt)

        if [ -z "$checkpoint" ]; then
            echo -e "${RED}错误：未找到红移值 $z_value 对应的检查点${NC}"
            echo -e "${YELLOW}z_checkpoint 内容预览："
            head -n 5 z_checkpoint.txt
            exit 1
        fi

        ls -ltr "$output/$opath/image1"/*_xp_1.bin | tail -4
        echo -e "   ${GREEN}建议检查点：${CYAN}$checkpoint (z=$z_value)${NC}"
        while true; do
            read -p "使用该检查点？[Y使用/N退出]: " yn
            case $yn in
                [Yy]* ) echo "继续执行..."; break;;
                [Nn]* ) echo "退出脚本"; exit 1;;
                * ) echo "请输入 Y 或 N";;
            esac
        done
    fi

    cd $rawpath
fi


#打印运行参数
echo -e "${CYAN}--------------------------------  运行参数  --------------------------------${NC}"
echo ''
echo -e "${CYAN}运行目录${NC}${PURPLE}          : $code_path/$opath/${NC}"
echo -e "${CYAN}数据目录${NC}${PURPLE}          : $output/$opath/${NC}"
echo -e "${CYAN}运行模式${NC}          :"
runtype=$'\n'
if [ -n "$RunIC" ]; then
    runtype+="${GREEN}▶ 初始条件生成${NC}"$'\n'
fi
if [ -n "$RunMain" ]; then
    runtype+="${YELLOW}▶ 主模拟进程${NC}"$'\n'
fi
if [ -n "$OnlyCIC" ]; then
    runtype="${MAGENTA}▶ 功率谱计算${NC}"$'\n'
fi
if [ -n "$Findhalo" ];then
    runtype+="${CYAN}▶ 查找暗晕${NC}"$'\n'
fi



# 格式化输出（保留2空格缩进）
if [ -n "$runtype" ]; then
    echo -e "                 ${runtype//$'\n'/$'\n'               }"
else
    echo -e "                 \033[31m未配置运行模式${NC}"
    exit 1
fi

echo -e "${CYAN}核心数${NC}            : ${PURPLE}$nncore${NC} = ${PURPLE}$nteam${NC} x ${PURPLE}$nnode${NC}"
echo -e "${CYAN}节点数${NC}            : ${PURPLE}$nnn${NC}"
echo -e "${CYAN}中微子${NC}            : ${PURPLE}$smnus${NC}"
echo -e "${CYAN}分辨率${NC}            : ${PURPLE}$box Mpc ; $ng 粒子${NC}"
echo -e "${CYAN}功率谱${NC}            : ${PURPLE}$cpktype${NC}"
echo -e "${CYAN}检查点${NC}            : ${PURPLE}$checkpoint $(awk -v line=$checkpoint '
            NR==line {
                raw = $1 + 0  
                z_sprintf = sprintf("%.3f", raw)
                sub(/\.$/, ".000", z_sprintf)
                print z_sprintf
                exit
            }' z_checkpoint.txt)${NC}"
echo ''
echo ''
echo ''

while true; do
    read -p "参数正确？[Y/N]: " yn
    case $yn in
        [Yy]* ) echo "继续执行..."; break;;
        [Nn]* ) echo "退出脚本"; exit 1;;
        * ) echo "请输入 Y 或 N";;
    esac
done
echo ''
echo ''

if [ -n "$OnlyCIC" ]; then
    flag='C'$flag
fi
name=$flag$box$((ng*nn))'_'$M_nu'_'$Cpk
echo $name
output=${output//\//\\/}
if [ ! -n "$OnlyCIC" ]; then
    sed -i "s/.*parameter :: opath=.*/   character(*),parameter :: opath='$output\/$opath\/'/" parameters.f90
    sed -i "s/.*parameter :: box=.*/   real,parameter :: box=$box/" parameters.f90
    sed -i "s/.*parameter :: nn=.*/   integer,parameter :: nn=$nn/" parameters.f90
    sed -i "s/.*parameter :: ng=.*/   integer(8),parameter :: ng=$ng/" parameters.f90
    sed -i "s/.*parameter :: calculate_PK = .*/   integer(8),parameter :: calculate_PK = $Cpk/" parameters.f90
    sed -i "s/.*real(8),dimension(3),parameter :: m_nu=.*/   real(8),dimension(3),parameter :: m_nu=[$smnus] ! mass_nus\/eV/" parameters.f90
    sed -i "s/.*parameter :: ncore=.*/   integer,parameter :: ncore=$nncore/" parameters.f90
    sed -i "s/.*parameter :: nteam=.*/   integer,parameter :: nteam=$nteam/" parameters.f90
    sed -i "s/.*parameter :: nnest=.*/   integer,parameter :: nnest=$nnest/" parameters.f90
    if [ $checkpoint -eq 1 ] || [ $newdir ]; then
        sed -i "s/   logical,parameter :: read_Gks=.*/   logical,parameter :: read_Gks=.false./" initialize.f90
        sed -i "s/   sim%cur_checkpoint=.*/   sim%cur_checkpoint=1/" main.f90
    else
        sed -i "s/   logical,parameter :: read_Gks=.*/   logical,parameter :: read_Gks=.true./" initialize.f90
        sed -i "s/   sim%cur_checkpoint=.*/   sim%cur_checkpoint=$checkpoint/" main.f90
    fi
    if [ $PP ]; then
        sed -i "s/.*logical,parameter :: PP=.*/   logical,parameter :: PP=.true./" kick.f90
    else
        sed -i "s/.*logical,parameter :: PP=.*/   logical,parameter :: PP=.false./" kick.f90
    fi

    if [ $PP_corr ]; then
        sed -i "s/.*logical,parameter :: PP_corr=.*/   logical,parameter :: PP_corr=.true./" kick.f90
    else
        sed -i "s/.*logical,parameter :: PP_corr=.*/   logical,parameter :: PP_corr=.false./" kick.f90
    fi
fi
# exit

# Modify the job name in run.qsub
#如果logname为''则初始化
if [ -z "$logname" ]; then
    log_name="run.log"
fi
sed -i "s/#PBS -N .*/#PBS -N $name/" run.qsub
sed -i "s/#PBS -q .*/#PBS -q $q/" run.qsub
sed -i "s/#PBS -o .*/#PBS -o .\/$log_name/" run.qsub
sed -i "s/date > .*/date > .\/$log_name/" run.qsub
sed -i "s/#PBS -l nodes=.*/#PBS -l nodes=$nnode:ppn=$ncore/" run.qsub
sed -i "s/#PBS -l mem=.*/#PBS -l mem=$mem\gb/" run.qsub
# sed -i "s/export OMP_STACKSIZE=.*/export OMP_STACKSIZE=$mem\G/" run.qsub
sed -i "s/export OMP_NUM_THREADS=.*/export OMP_NUM_THREADS=$ncore/" run.qsub
sed -i "s/export FOR_COARRAY_NUM_IMAGES=.*/export FOR_COARRAY_NUM_IMAGES=$nnn/" run.qsub
sed -i "s/export PROCS=.*/export PROCS=$nnn/" run.qsub
sed -i "s/export ntasks_per_node=.*/export ntasks_per_node=$ntasks_per_node/" run.qsub

sic="IC=\".\/utilities\/ic.x\"        \&\&echo \"Running \$IC\"   \&\&echo \"-genvall -machinefile \$HOST_FILE -n \$PROCS \$IC\"   > cafconfig.txt \&\&\$IC   \&\& echo \"Finish \$IC\""
scic="cic=\".\/utilities\/cicpower.x\" \&\&echo \"Running \$cic\"  \&\&echo \"-genvall -machinefile \$HOST_FILE -n \$PROCS \$cic\"  > cafconfig.txt \&\&\$cic  \&\& echo \"Finish \$cic\""
if [ $RunIC ]; then
    echo Run IC
    sed -i "s/# $sic/$sic/" run.qsub
    sed -i "s/# $scic/$scic/" run.qsub
else
    echo No  IC
    sed -i "s/^$sic/# $sic/" run.qsub
    sed -i "s/^$scic/# $scic/" run.qsub
fi


sMAIN="MAIN=\".\/main.x\"              \&\&echo \"Running \$MAIN\" \&\&echo \"-genvall -machinefile \$HOST_FILE -n \$PROCS \$MAIN\" > cafconfig.txt \&\&\$MAIN \&\& echo \"Finish \$MAIN\""
sCIC="CIC=\".\/utilities\/cicpower.x\" \&\&echo \"Running \$CIC\"  \&\&echo \"-genvall -machinefile \$HOST_FILE -n \$PROCS \$CIC\"  > cafconfig.txt \&\&\$CIC  \&\& echo \"Finish \$CIC\"" 
if [ $RunMain ]; then
    echo Run Main
    sed -i "s/# $sMAIN/$sMAIN/" run.qsub
    sed -i "s/# $sCIC/$sCIC/" run.qsub
else
    echo No  Main
    sed -i "s/^$sMAIN/# $sMAIN/" run.qsub
    sed -i "s/^$sCIC/# $sCIC/" run.qsub
fi
# sed -i "s/^$sCIC/# $sCIC/" run.qsub

if [ $RunMain ]; then
    sed -i "s/^make clean \&\&make > make.log /make clean \&\&make > make.log /" run.qsub
fi
if [ $RunIC ]; then
    sed -i "s/^cd utilities \&\& make clean \&\& make > make.log \&\& cd .. /cd utilities \&\& make clean \&\& make > make.log \&\& cd .. /" run.qsub
fi

sFOF="FOF=\".\/utilities\/fof.x\" \&\&echo \"Running \$FOF\"  \&\&echo \"-genvall -machinefile \$HOST_FILE -n \$PROCS \$FOF\"  > cafconfig.txt \&\&\$FOF  \&\& echo \"Finish \$FOF\"" 
if [ $Findhalo ]; then
    echo Run FOF    
    sed -i "s/# cd utilities \&\& make clean \&\& make > make.log \&\& cd .. /cd utilities \&\& make clean \&\& make > make.log \&\& cd .. /" run.qsub
    sed -i "s/# $sFOF/$sFOF/" run.qsub
else
    echo No  FOF
    sed -i "s/^$sFOF/# $sFOF/" run.qsub
fi

sOCIC="OCIC=\".\/utilities\/cicpower.x\" \&\&echo \"Running \$OCIC\"  \&\&echo \"-genvall -machinefile \$HOST_FILE -n \$PROCS \$OCIC\"  > cafconfig.txt \&\&\$OCIC  \&\& echo \"Finish \$OCIC\"" 
if [ $OnlyCIC ]; then
    log_name=cic.log
    echo Only CIC
    sed -i "s/#PBS -N .*/#PBS -N $name/" run.qsub
    sed -i "s/#PBS -o .*/#PBS -o .\/$log_name/" run.qsub
    sed -i "s/date > .*/date > .\/$log_name/" run.qsub
    sed -i "s/^$sic/# $sic/" run.qsub
    sed -i "s/^$scic/# $scic/" run.qsub
    sed -i "s/# $sCIC/# $sCIC/" run.qsub
    sed -i "s/^$sMAIN/# $sMAIN/" run.qsub
    sed -i "s/# $sOCIC/$sOCIC/" run.qsub
    sed -i "s/^make clean \&\&make > make.log /# make clean \&\&make > make.log /" run.qsub
    sed -i "s/# cd utilities \&\& make clean \&\& make > make.log \&\& cd .. /cd utilities \&\& make clean \&\& make > make.log \&\& cd .. /" run.qsub
else
    sed -i "s/^$sOCIC/# $sOCIC/" run.qsub
fi


# exit 1

check_job=$(qstat -tan -u ChenBH | awk '!/login01:/ && NR>5 && $4 == "'"$name"'" {print $0}')

if [ -n "$check_job" ]; then
    echo -e "\033[31m队列中存在同名任务:${NC}"
    qstat -tan -u ChenBH | awk 'NR==5 || $4 == "'"$name"'"'
    job_id=$(qstat -tan -u ChenBH | awk 'NR==5 || $4 == "'"$name"'"' | grep -oE '[0-9]+\.login01')
    
    while true; do
        read -p "是否替换[Rr]/保留[Kk]/取消[Cc]？: " yn
        case $yn in
            [Rr]* )  
                while true; do
                    read -p "确认替换原有任务($job_id 将会被取消)？ [Y/N]: " yn
                    case $yn in
                        [Yy]* ) qdel $job_id; break 2;; 
                        * ) echo "请重新选择"; break 1;;
                    esac
                done;;
            [Kk]* ) 
                echo "保留原任务、继续执行..."; 
                break;;
            [Cc]* ) 
                echo "退出脚本"; 
                exit 1;;
            * ) 
                echo "请输入 R/K/C";;
        esac
    done
fi

if [ -n "$newdir" ]; then  # 正确判断是否启用创建新目录模式
    target_dir="$code_path/$opath"  # 定义实际操作的目录路径

    # 如果目标目录已存在则备份日志
    if [ -d "$target_dir" ]; then
        timestamp=$(date +"%Y%m%d_%H%M%S")
        backup_file="${timestamp}.log"
        
        if [ -f "$target_dir/run.log" ]; then
            echo -e "${YELLOW}发现历史日志：备份为 ${backup_file}${NC}"
            mkdir -pv /home/ChenBH/mnus/log_backup/$opath
            cp -v "$target_dir/run.log" "/home/ChenBH/mnus/log_backup/$opath/$backup_file"
        fi
    fi

    # 根据模式操作目录
    if [ ! -n "$OnlyCIC" ]; then
        echo -e "${CYAN}全量模式：重建目录[$target_dir]${NC}"
        rm -r $code_path/$opath/*
        mkdir -p $code_path/$opath
        cp -r ./* $code_path/$opath
    else
        echo -e "${CYAN}增量模式：更新CIC文件${NC}"
        cp -r ./run.qsub $code_path/$opath
        cp -r ./utilities/*  $code_path/$opath/utilities
    fi

    # 目录切换保护
    cd "$target_dir" || {
        echo -e "${RED}错误：无法进入目录 $target_dir${NC}"
        exit 1
    }
    echo -e "${GREEN}当前工作目录：${NC}$(pwd)"
fi

# exit 0
rm -v *.log
qsub run.qsub >$log_name
sleep 2
qstat -tan -u ChenBH
while true; do
    read -t 3 -p "是否监控输出：Y/N [N]" yn
    if [ $? -ne 0 ]; then
        echo ""
        echo -e "${RED}输入超时,自动退出${NC}"
        echo "tail -f $code_path/$opath/$log_name"
        exit 1
    fi
    case $yn in
        [Yy]* ) echo "-------------------- 程序输出 --------------------"; break;;
        * ) echo "tail -f $code_path/$opath/$log_name"; exit 1;;
    esac
done
tail -f $log_name





