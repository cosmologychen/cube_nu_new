# # # fi

# # # if [ $RunMain ]; then
# # #     ./main.x >> run.log 2>&1  &&\
# # #     ./utilities/cicpower.x >> run.log 2>&1 
# # # fi

# # # if [ $OnlyCIC ]; then
# # #     ./utilities/cicpower.x >> run.log 2>&1 
# # # fi
