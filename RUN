# 打印运行参数
info() {
    RED='\033[31m'; CYAN='\033[36m'; GREEN='\033[32m'; YELLOW='\033[33m'; NC='\033[0m'; MAGENTA='\033[35m'
    echo ""
    echo ""
    echo -e "${CYAN}--------------------------------  运行参数  --------------------------------${NC}"
    echo ''
    echo -e "${CYAN}运行目录${NC}${PURPLE}           : $code_path/$opath/${NC}"
    if [ "$log_name" != "None" ]; then
        echo -e "${CYAN}日志文件${NC}${PURPLE}           : $code_path/$opath/$log_name${NC}"
    fi

    echo -e "${CYAN}数据目录${NC}${PURPLE}           : $output/$opath/${NC}"

    if [ "$z_path" != "None" ]; then
        echo -e "${CYAN}检查点文件${NC}${PURPLE}         : ${z_path}${NC}"
    fi

    if [ "$h_path" != "None" ]; then
        echo -e "${CYAN}halo检查点${NC}${PURPLE}         : ${h_path}${NC}"
    fi

    if [ "$s_path" != "None" ]; then
        echo -e "${CYAN}随计数种子${NC}${PURPLE}         : ${s_path}${NC}"
    fi

    if [ "$n_path" != "None" ]; then
        echo -e "${CYAN}白噪声文件${NC}${PURPLE}         : ${n_path}${NC}"
    fi

    if [ "$r_path" != "None" ]; then
        echo -e "${CYAN}密度场文件${NC}${PURPLE}         : ${r_path}${NC}"
    fi


    echo -e "${CYAN}运行模式($zip_type)${NC}     :"
    runtype=$''
    if [ "$RunIC" == true ]; then
        runtype+="${GREEN}▶ 初始条件生成${NC}"$'\n'
    fi
    if [ "$RunMain" == true ]; then
        runtype+="${YELLOW}▶ 主模拟进程${NC}"$'\n'
    fi
    if [ "$RunCIC" == true ]; then
        runtype+="${MAGENTA}▶ 功率谱计算${NC}"$'\n'
    fi
    if [ "$Findhalo" == true ];then
        runtype+="${CYAN}▶ 查找暗晕${NC}"$'\n'
    fi
    if [ "$RunDSP" == true ];then
        runtype+="${CYAN}▶ 计算位移密度${NC}"$'\n'
    fi
    if [ "$Runc2u" == true ];then
        runtype+="${CYAN}▶ 估计不同中微子模型密度场${NC}"$'\n'
    fi

    # 格式化输出（保留2空格缩进）
    if [ -n "$runtype" ]; then
        echo -e "                     ${runtype//$'\n'/$'\n'                     }"
    else
        echo -e "                       \033[31m未配置运行模式${NC}"
        exit 1
    fi

    echo -e "${CYAN}核心数${NC}             : ${PURPLE}$nn${NC} , ${PURPLE}$nncore${NC} = ${PURPLE}$nteam${NC} x ${PURPLE}$nnest${NC}"
    echo -e "${CYAN}分辨率${NC}             : ${PURPLE}$box Mpc ; $ng 粒子${NC}"
    echo -e "${CYAN}检查点${NC}             : ${PURPLE}$checkpoint $(awk -v line=$checkpoint '
                NR==line {
                    raw = $1 + 0  
                    z_sprintf = sprintf("%.3f", raw)
                    sub(/\.$/, ".000", z_sprintf)
                    print z_sprintf
                    exit
                }' z_checkpoint.txt)${NC}"
    echo ''

    echo ""
    echo -e "${CYAN}计算PP${NC}             : ${PURPLE}$PP${NC}"
    echo -e "${CYAN}计算PM3${NC}            : ${PURPLE}$PM3${NC}"
    echo ""

    echo -e "${CYAN}Hubble常数   h_0${NC}   : ${PURPLE}$h0${NC}"
    echo -e "${CYAN}冷暗物质密度 Ω_c${NC}   : ${PURPLE}$omc${NC}"
    echo -e "${CYAN}重子物质密度 Ω_b${NC}   : ${PURPLE}$omb${NC}"
    echo -e "${CYAN}谱指数       n_s${NC}   : ${PURPLE}$ns${NC}"
    echo -e "${CYAN}功率谱振幅   A_s${NC}   : ${PURPLE}$As${NC}"

    if [ $(echo "$M_nu > 0.0" | bc) ]; then
        echo -e "${CYAN}中微子质量${NC}         : ${YELLOW}$smnus${NC}"
        echo -e "${CYAN}功率谱算法${NC}         : ${PURPLE}$cpktype${NC}"
    fi
    echo ''
    echo ''
}

check_para() {
    local opt="$1"
    local val="$2"
    local type="$3"

    case "$type" in
        path)
            if [[ -z "$val" || "$val" == -* ]]; then
                echo "错误: $opt 需要一个非选项路径参数" >&2
                #usage >&2
                exit 1
            fi
            ;;
        bool)
            local val=$(echo "$val" | tr '[:upper:]' '[:lower:]')
            if ! [[ "$val" == "true" || "$val" == "false" || "$val" == "only" ]]; then
                echo "错误: $opt 的值必须是 true、false 或 only（当前: '$val'）" >&2
                #usage >&2
                exit 1
            fi
            ;;
        int)
            if ! [[ "$val" =~ ^[+-]?[0-9]+$ ]]; then
                echo "错误: $opt 必须是整数（当前: '$val'）" >&2
                #usage >&2
                exit 1
            fi
            ;;
        number)
            if ! [[ "$val" =~ ^[+-]?[0-9]*\.?[0-9]+([eE][+-]?[0-9]+)?$ ]]; then
                echo "错误: $opt 必须是有效数字（当前: '$val'）" >&2
                #usage >&2
                exit 1
            fi
            ;;
        enum_01)
            if [[ "$val" != "0" && "$val" != "1" ]]; then
                echo "错误: $opt 的值必须是 0 或 1（当前: '$val'）" >&2
                #usage >&2
                exit 1
            fi
            ;;
        enum_Cpk)
            if [[ "$val" != "-1" && "$val" != "0" && "$val" != "1" && "$val" != "2" ]]; then
                echo "错误: $opt 的值必须是 -1、0、1 或 2（当前: '$val'）" >&2
                #usage >&2
                exit 1
            fi
            ;;
        *)
            echo "内部错误: 未知校验类型 '$type'" >&2
            exit 1
            ;;
    esac
}

para_2_code() {

    if [ $ZIPX == "1" ]; then
        sed -i "s/.*OPTIONS+=-DZIPX/OPTIONS+=-DZIPX/" Makefile
        sed -i "s/.*OPTIONS+=-DZIPX/OPTIONS+=-DZIPX/" utilities/Makefile
    else
        sed -i "s/.*OPTIONS+=-DZIPX/#OPTIONS+=-DZIPX/" Makefile
        sed -i "s/.*OPTIONS+=-DZIPX/#OPTIONS+=-DZIPX/" utilities/Makefile
    fi

    sed -i "s/.*parameter :: opath=.*/  character(*),parameter :: opath='${output//\//\\/}\/$opath\/'/" parameters.f90
    sed -i "s/.*parameter :: box=.*/  real,parameter :: box=$box/" parameters.f90
    sed -i "s/.*parameter :: nn=.*/  integer,parameter :: nn=$nn/" parameters.f90
    sed -i "s/.*parameter :: ng=.*/  integer(8),parameter :: ng=$ng/" parameters.f90
    sed -i "s/.*parameter :: calculate_PK = .*/   integer(8),parameter :: calculate_PK = $Cpk/" parameters.f90
    sed -i "s/.*real(8),dimension(3),parameter :: m_nu=.*/   real(8),dimension(3),parameter :: m_nu=[$smnus] ! mass_nus\/eV/" parameters.f90
    sed -i "s/.*parameter :: ncore=.*/  integer,parameter :: ncore=$nncore/" parameters.f90
    sed -i "s/.*parameter :: nteam=.*/  integer,parameter :: nteam=$nteam/" parameters.f90
    sed -i "s/.*parameter :: nnest=.*/  integer,parameter :: nnest=$nnest/" parameters.f90
    sed -i "s/.*parameter :: h0=.*/   real, parameter :: h0=$h0/" parameters.f90
    sed -i "s/.*parameter :: omega_cdm=.*/  real,parameter :: omega_cdm=$omc/" parameters.f90
    sed -i "s/.*parameter :: omega_bar=.*/  real,parameter :: omega_bar=$omb/" parameters.f90
    sed -i "s/.*parameter :: n_s=.*/  real,parameter :: n_s=$ns/" parameters.f90
    sed -i "s/.*parameter :: A_s=.*/  real,parameter :: A_s=$As/" parameters.f90
    if [ $checkpoint -eq 1 ]; then
        sed -i "s/.*logical,parameter :: read_Gks=.*/   logical,parameter :: read_Gks=.false./" initialize.f90
        sed -i "s/.*sim%cur_checkpoint=.*/   sim%cur_checkpoint=1/" main.f90
    else
        sed -i "s/.*logical,parameter :: read_Gks=.*/   logical,parameter :: read_Gks=.true./" initialize.f90
        sed -i "s/.*sim%cur_checkpoint=.*/   sim%cur_checkpoint=$checkpoint/" main.f90
    fi

    sed -i "s/\(cur_checkpoint=\) \([0-9]\+\),\([0-9]\+\)/\1 $z1,$z2/" utilities/cicpower.f90
    
    if [ "$PM3" ==  true ]; then
        sed -i "s/.*logical,parameter :: PM3=.*/  logical,parameter :: PM3=.true./" kick.f90
    else
        sed -i "s/.*logical,parameter :: PM3=.*/  logical,parameter :: PM3=.false./" kick.f90
    fi


    if [ "$PP" ==  true ]; then
        sed -i "s/.*logical,parameter :: PP=.*/  logical,parameter :: PP=.true./" kick.f90
    else
        sed -i "s/.*logical,parameter :: PP=.*/  logical,parameter :: PP=.false./" kick.f90
    fi
    

    if [ "$RunIC" == true ]; then

        if [ "$s_path" != "None" ]; then
            for ((i=1; i<=nnn; i++)); do
                mkdir -p $output/$opath/image$i
                cp -v $s_path/image$i/seed_$i.bin $output/$opath/image$i/seed_$i.bin
            done
            sed -i "s/.*#define READ_SEED/#define READ_SEED/" utilities/ic.f90
        else
            sed -i "s/.*#define READ_SEED/!#define READ_SEED/" utilities/ic.f90
        fi

        if [ "$n_path" != "None" ]; then
            for ((i=1; i<=nnn; i++)); do
                mkdir -p $output/$opath/image$i
                cp -v $n_path/image$i/noise_$i.bin $output/$opath/image$i/noise_$i.bin
            done
            sed -i "s/.*#define READ_NOISE/#define READ_NOISE/" utilities/ic.f90
        else
            sed -i "s/.*#define READ_NOISE/!#define READ_NOISE/" utilities/ic.f90
        fi

        if [ "$r_path" != "None" ]; then
            for ((i=1; i<=nnn; i++)); do
                mkdir -p $output/$opath/image$i
                cp -v $r_path/image$i/delta_L_$i.bin $output/$opath/image$i/delta_L_$i.bin
            done
            sed -i "s/.*#define READ_RHO/#define READ_RHO/" utilities/ic.f90
        else
            sed -i "s/.*#define READ_RHO/!#define READ_RHO/" utilities/ic.f90
        fi
    fi
}

# 创建运行目录
copy_code() {
    target_dir="$code_path/$opath"  # 定义实际操作的目录路径
    # 如果目标目录已存在则备份日志
    if [ -d "$target_dir" ]; then
        timestamp=$(date +"%Y%m%d_%H%M%S")
        backup_file="${timestamp}.log"
        
        if [ -f "$target_dir/run.log" ]; then
            echo -e "${YELLOW}发现历史日志: 备份为 ${backup_file}${NC}"
            mkdir -pv /home/cossim/cube_nu/log_backup/$opath
            cp -v "$target_dir/run.log" "/home/cossim/cube_nu/log_backup/$opath/$backup_file"
        fi
    fi

    # 根据模式操作目录
    if [ "$RunIC" == true ] || [ "$RunMain" == true ]; then
        echo -e "${CYAN}全量模式: 重建目录[ $target_dir ]${NC}"
        rm -r $code_path/$opath/*
        mkdir -p $code_path/$opath
        cp -r ./* $code_path/$opath
    else
        echo -e "${CYAN}增量模式: 更新CIC文件${NC}"
        cp -r ./run.qsub $code_path/$opath
        cp -r ./utilities/*  $code_path/$opath/utilities
    fi

    # 目录切换保护
    cd "$target_dir" || {
        echo -e "${RED}错误: 无法进入目录 $target_dir${NC}"
        exit 1
    }
    echo -e "${GREEN}当前工作目录: ${NC}$(pwd)"
    if [ "$z_path" != "None" ]; then
        cp -v $z_path $target_dir
    fi

    if [ "$h_path" != "None" ]; then
        cp -v $h_path $target_dir
    fi
}

# 定义执行函数（处理输出重定向） local
local_run() {
    local cmd="$1"
    if [ "$log_name" == "None" ]; then
        echo ""
        echo ""
        echo $cmd
        $cmd
    else
        echo ""
        echo ""
        echo eval "$cmd >> $(pwd)/$log_name 2>&1"
        eval "$cmd >> $log_name 2>&1"
    fi
}

qsub_ini() {
    sed -i "s/#PBS -N .*/#PBS -N $name/" run.qsub
    sed -i "s/#PBS -q .*/#PBS -q $q/" run.qsub
    sed -i "s/#PBS -o .*/#PBS -o .\/$log_name/" run.qsub
    sed -i "s/date > .*/date > .\/$log_name/" run.qsub
    sed -i "s/#PBS -l nodes=.*/#PBS -l nodes=$nnode:ppn=$ncore/" run.qsub
    sed -i "s/#PBS -l mem=.*/#PBS -l mem=$mem\gb/" run.qsub
    sed -i "s/export OMP_NUM_THREADS=.*/export OMP_NUM_THREADS=$ncore/" run.qsub
    sed -i "s/export FOR_COARRAY_NUM_IMAGES=.*/export FOR_COARRAY_NUM_IMAGES=$nnn/" run.qsub
    sed -i "s/export PROCS=.*/export PROCS=$nnn/" run.qsub
    sed -i "s/export ntasks_per_node=.*/export ntasks_per_node=$ntasks_per_node/" run.qsub

    sic="run_program \$IC"
    scic="run_program \$cic"
    sMAIN="run_program \$MAIN"
    sCIC="run_program \$CIC" 
    sFOF="run_program \$FOF"
    sDSP="run_program \$DSP"
    sC2U="run_program \$C2U"

    make clean && cd utilities && make clean && cd ..
    if [ "$RunIC" == true ]; then
        cd utilities && make ic.x cicpower.x && cd .. || exit 1
        sed -i "s/# $sic/$sic/" run.qsub
        sed -i "s/# $scic/$scic/" run.qsub
    else
        sed -i "s/^$sic/# $sic/" run.qsub
        sed -i "s/^$scic/# $scic/" run.qsub
    fi

    if [ "$RunMain" == true ]; then
        make  || exit 1
        cd utilities && make cicpower.x && cd .. || exit 1
        sed -i "s/# $sMAIN/$sMAIN/" run.qsub
        if [ "$RunCIC" == true ]; then
            sed -i "s/# $sCIC/$sCIC/" run.qsub
        else
            sed -i "s/^$sCIC/# $sCIC/" run.qsub
        fi
    else
        sed -i "s/^$sMAIN/# $sMAIN/" run.qsub
        sed -i "s/^$sCIC/# $sCIC/" run.qsub
    fi

    if [ "$RunMain" == false ] && [ "$RunCIC" == true ]; then 
        cd utilities && make cicpower.x && cd .. || exit 1
        sed -i "s/# $sCIC/$sCIC/" run.qsub
    fi

    if [ "$Findhalo" == true ]; then
        cd utilities && make fof.x && cd .. || exit 1
        sed -i "s/# $sFOF/$sFOF/" run.qsub
    else
        sed -i "s/^$sFOF/# $sFOF/" run.qsub
    fi

    if [ "$RunDSP" == true ]; then
        cd utilities && make dsp.x && cd .. || exit 1
        sed -i "s/# $sDSP/$sDSP/" run.qsub
    else
        sed -i "s/^$sDSP/# $sDSP/" run.qsub
    fi

    if [ "$Runc2u" == true ]; then
        cd utilities && make cdm2nu.x && cd .. || exit 1
        sed -i "s/# $sC2U/$sC2U/" run.qsub
    else
        sed -i "s/^$sC2U/# $sC2U/" run.qsub
    fi
}

# 执行函数 pbs
pbs_run() {
    
    check_job=$(qstat -tan -u $USER | awk '!/login01:/ && NR>5 && $4 == "'"$name"'" {print $0}')

    if [ -n "$check_job" ]; then
        echo -e "\033[31m队列中存在同名任务:${NC}"
        qstat -tan -u ChenBH | awk 'NR==5 || $4 == "'"$name"'"'
        job_id=$(qstat -tan -u ChenBH | awk 'NR==5 || $4 == "'"$name"'"' | grep -oE '[0-9]+\.login01')
        
        while true; do
            read -p "是否替换[Rr]/保留[Kk]/取消[Cc]？: " yn
            case $yn in
                [Rr]* )  
                    while true; do
                        read -p "确认替换原有任务($job_id 将会被取消)？ [Yy/Nn]: " yn
                        case $yn in
                            [Yy]* ) qdel $job_id; break 2;; 
                            * ) echo "请重新选择"; break 1;;
                        esac
                    done;;
                [Kk]* ) 
                    echo "保留原任务、继续执行..."; 
                    break;;
                [Cc]* ) 
                    echo "退出脚本"; 
                    exit 1;;
                * ) 
                    echo "请输入 R/K/C";;
            esac
        done
    fi
    
    if [ -n "$newdir" ]; then  # 正确判断是否启用创建新目录模式
        copy_code
    fi

    qsub_ini
    if [ -n "$newdir" ]; then 
        log_name=$code_path/$opath/$log_name
    fi

    rm -v *.log
    qsub run.qsub >$log_name
    sleep 2
    qstat -tan -u ChenBH
    while true; do
        read -t 3 -p "是否监控输出: Yy/Nn [N]" yn
        if [ $? -ne 0 ]; then
            echo ""
            echo -e "${RED}输入超时,自动退出${NC}"
            echo "tail -f $log_name"
            exit 0
        fi
        case $yn in
            [Yy]* ) echo "-------------------- 程序输出 --------------------"; break;;
            * ) 
                echo "tail -f $log_name"
                exit 0
            ;;
        esac
    done
    echo "tail -f $log_name"
    tail -f $log_name
}

# 解析命令行参数
get_para() {
    all_yes=false 
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -Y|-y)
                all_yes=true
                shift
                ;;
            -c)
                check_para "-c" "$2" "path"
                code_path="$2"
                shift 2
                ;;
            -o)
                check_para "-o" "$2" "path"
                output="$2"
                shift 2
                ;;
            -flag)
                check_para "-flag" "$2" "path"
                flag="$2"
                shift 2
                ;;
            -log)
                check_para "-log" "$2" "path"
                log_name="$2"
                shift 2
                ;;
            -z)
                check_para "-z" "$2" "path"
                z_path="$2"
                shift 2
                ;;
            -h)
                check_para "-h" "$2" "path"
                h_path="$2"
                shift 2
                ;;
            -s)
                check_para "-s" "$2" "path"
                s_path="$2"
                shift 2
                ;;
            -n)
                check_para "-n" "$2" "path"
                n_path="$2"
                shift 2
                ;;
            -r)
                check_para "-r" "$2" "path"
                r_path="$2"
                shift 2
                ;;

            -IC)
                check_para "-IC" "$2" "bool"
                RunIC="$2"
                shift 2
                ;;
            -Main)
                check_para "-Main" "$2" "bool"
                RunMain="$2"
                shift 2
                ;;
            -Halo)
                check_para "-Halo" "$2" "bool"
                Findhalo="$2"
                shift 2
                ;;
            -DSP)
                check_para "-DSP" "$2" "bool"
                RunDSP="$2"
                shift 2
                ;;
            -C2u)
                check_para "-C2u" "$2" "bool"
                Runc2u="$2"
                shift 2
                ;;
            -Power)
                check_para "-Power" "$2" "bool"
                RunCIC="$2"
                shift 2
                ;;
            -PM3)
                check_para "-PM3" "$2" "bool"
                PM3="$2"
                shift 2
                ;;
            -PP)
                check_para "-PP" "$2" "bool"
                PP="$2"
                shift 2
                ;;

            -ncore)
                check_para "-ncore" "$2" "int"
                ncore="$2"
                shift 2
                ;;
            -nnest)
                check_para "-nnest" "$2" "int"
                nnest="$2"
                shift 2
                ;;
            -nn)
                check_para "-ng" "$2" "int"
                nn="$2"
                shift 2
                ;;
            -ng)
                check_para "-ng" "$2" "int"
                ng="$2"
                shift 2
                ;;
            -z1)
                check_para "-z1" "$2" "int"
                z1="$2"
                shift 2
                ;;
            -z2)
                check_para "-z2" "$2" "int"
                z2="$2"
                shift 2
                ;;
            -checkpoint|-cp)
                check_para "-cp" "$2" "int"
                checkpoint="$2"
                shift 2
                ;;

            -box)
                check_para "-box" "$2" "number"
                box="$2"
                shift 2
                ;;
            -h0)
                check_para "-h0" "$2" "number"
                h0="$2"
                shift 2
                ;;
            -omb)
                check_para "-omb" "$2" "number"
                omb="$2"
                shift 2
                ;;
            -omc)
                check_para "-omc" "$2" "number"
                omc="$2"
                shift 2
                ;;
            -As)
                check_para "-As" "$2" "path"
                As="$2"
                shift 2
                ;;
            -ns)
                check_para "-ns" "$2" "number"
                ns="$2"
                shift 2
                ;;
            -Mnu)
                check_para "-Mnu" "$2" "number"
                M_nu="$2"
                shift 2
                ;;

            -ZIPX)
                check_para "-ZIPX" "$2" "enum_01"
                ZIPX="$2"
                shift 2
                ;;
            -Hnu)
                check_para "-Hnu" "$2" "enum_01"
                H_nu="$2"
                shift 2
                ;;
            -Cpk)
                check_para "-Cpk" "$2" "enum_Cpk"
                Cpk="$2"
                shift 2
                ;;

            -mnus)
                m_nus=()
                shift
                for i in {1..3}; do
                    if [[ $# -eq 0 || "$1" == -* ]]; then
                        echo "错误: -mnus 必须后跟 3 个数值（当前只提供了 $((i-1)) 个）" >&2
                        print_usage >&2
                        exit 1
                    fi
                    check_para "-mnus (第${i}个)" "$1" "number"
                    m_nus+=("$1")
                    shift
                done
                ;;

            -H|--help)
                usage
                ;;

            *)
                echo "错误: 未知选项 '$1'" >&2
                exit 1
                ;;
        esac
    done
}

# 按照规则初始化脚本参数
run_para_ini(){

    Mnu=$(printf '%s\n' "${m_nus[@]}" | awk '{sum += $1} END {print sum}')
    if [[ $(echo "${Mnu}*100000" | bc | cut -d. -f1) -eq 0 ]]; then
        if [[ $(echo "${M_nu}*100000" | bc | cut -d. -f1) -gt 0 ]]; then
            case "$H_nu" in
                0)
                    m_nu1=$(echo "scale=16;$M_nu / 3" | bc) && m_nus=($m_nu1 $m_nu1 $m_nu1) #DG
                    ;;
                1)
                    m_nus=($M_nu 0.0 0.0) #IH
                    ;;
                *)
                    echo "错误排序参数 $H_nu"
                    exit 1
                    ;;
            esac
        fi
    else
        M_nu=$Mnu
    fi

    smnus="${m_nus[0]}"
    for ((i=1; i<3; i++)); do
        val="${m_nus[$i]}"
        if (( $(awk "BEGIN { print ($val < 0) ? 1 : 0 }") )); then
            echo "错误: m_nus[$i] = $val < 0，中微子质量不能为负！" >&2
            exit 1
        fi
        smnus="$smnus,$val"
    done

    if [ $ZIPX == "0" ]; then
        zip_type="原始"
    else
        zip_type="压缩"
    fi

    if [ $(echo "$M_nu == 0.0" | bc) -eq 1 ]; then
        cpktype='无'
    else
        if  [ "$Cpk" = "-1" ]; then
            cpktype='完全使用CAMB'
        elif [ "$Cpk" = "0" ]; then
            cpktype='部分使用CAMB'
        elif [ "$Cpk" = "1" ]; then
            cpktype='使用拼接功率谱'
        elif [ "$Cpk" = "2" ]; then
            cpktype='使用全局功率谱'
        else
            echo -e "${RED}功率谱算法设置错误${NC}"
            exit 1
        fi
    fi

    if [ "$log_name" == "None" ];then
        log_name=run.log
    fi


    if [ "$RunIC" == only ]; then
        RunIC=true
        RunMain=false
        Findhalo=false
        RunCIC=false
        RunDSP=false
        Runc2u=false
        flag='I'$flag
        checkpoint=1
    fi

    if [ "$RunMain" == only ]; then
        RunIC=false
        RunMain=true
        Findhalo=false
        RunCIC=false
        RunDSP=false
        Runc2u=false
    fi

    if [ "$RunCIC" == only ]; then
        RunMain=false
        RunIC=false
        Findhalo=false
        RunCIC=true
        RunDSP=false
        Runc2u=false
        checkpoint=1
        flag='P'$flag
    fi

    if [ "$Findhalo" == only ]; then
        RunIC=false
        RunMain=false
        Findhalo=true
        RunCIC=false
        RunDSP=false
        Runc2u=false
        checkpoint=1
    fi

    if [ "$RunDSP" == only ]; then
        RunIC=false
        RunMain=false
        Findhalo=false
        RunCIC=false
        RunDSP=true
        Runc2u=false
        checkpoint=1
        flag='D'$flag
    fi


    if [ "$Runc2u" == only ]; then
        RunIC=false
        RunMain=false
        Findhalo=false
        RunCIC=false
        RunDSP=false
        Runc2u=true
        checkpoint=1
        flag='U'$flag
    fi

    if [ "$PM3" ==  false ]; then
        PP=false
    fi


    if [ "$r_path" != "None" ]; then
        n_path="None"
    else
        if [ "$n_path" != "None" ]; then
            s_path="None"
        fi
    fi

    code_path="${code_path/#~\//$HOME/}"
    output="${output/#~\//$HOME/}"
    opath=$flag$box'_'$ng'_'$nn'_'$M_nu'_'$Cpk
    name=$flag$box$((ng*nn))'_'$M_nu'_'$Cpk
    nnn=$((nn*nn*nn))
    if [ $nn -gt 1 ]; then
        nnode=$((nn*nn*nn/ntasks_per_node))
        nncore=$((ncore/ntasks_per_node))
    else
        nnode=1
        nncore=$((ncore))
    fi
    nteam=$((nncore/nnest))

    if [ "$checkpoint" -ne 1 ]; then
        rawpath=$(pwd)
        echo $rawpath
        cd $code_path/$opath

        if [ "$checkpoint" -ne -1 ]; then
            # ======== 统一文件验证 ========
            target_file="$output/$opath/image1/$(awk -v line=$checkpoint '
                NR==line {
                    raw = $1 + 0  
                    z_sprintf = sprintf("%.3f", raw)
                    sub(/\.$/, ".000", z_sprintf)
                    print z_sprintf
                    exit
                }' z_checkpoint.txt)_xp_1.bin"

            echo $target_file
            if [ ! -f "$target_file" ]; then
                echo $target_file
                target_file="$output/$opath/image1/$(awk -v line=$checkpoint '
                    NR==line {
                        raw =  $1 + 0.001
                        z_sprintf = sprintf("%.3f", raw)
                        sub(/\.$/, ".000", z_sprintf)
                        print z_sprintf
                        exit
                    }' z_checkpoint.txt)_xp_1.bin"
                if [ ! -f "$target_file" ]; then
                    echo $target_file
                    target_file="$output/$opath/image1/$(awk -v line=$checkpoint '
                        NR==line {
                            raw =  $1 - 0.0015
                            z_sprintf = sprintf("%.3f", raw)
                            sub(/\.$/, ".000", z_sprintf)
                            print z_sprintf
                            exit
                        }' z_checkpoint.txt)_xp_1.bin"
                    if [ ! -f "$target_file" ]; then
                        checkpoint=-1
                    fi
                fi
            fi
        fi

        if [ 1 -gt "$checkpoint" ]; then
            echo -e "${RED}无效检查点...${NC}"
            
            # 验证输出目录存在性
            if [ ! -d "$output/$opath/image1" ]; then
                echo -e "${RED}错误: 目录不存在 $output/$opath/image1${NC}"
                exit 1
            fi

            # 获取最新文件（按修改时间倒序）
            latest_file=$(ls -t "$output/$opath/image1"/*_xp_1.bin 2>/dev/null | head -n 1)
            
            if [ -z "$latest_file" ]; then
                echo -e "${RED}错误: 找不到任何xp_1.bin文件${NC}"
                echo -e "${YELLOW}可用文件列表: "
                ls -halFtr "$output/$opath/image1"/*_xp_1.bin 2>/dev/null || echo "无可用文件"
                exit 1
            fi

            # 从文件名提取红移值（支持小数和科学计数法）
            z_value=$(basename "$latest_file" | grep -oE '^[0-9]+\.?[0-9]*([eE][-+]?[0-9]+)?')
            z_value=$(echo "$z_value=" | awk '{printf "%.3f", $1}')
            
            if [ -z "$z_value" ]; then
                echo -e "${RED}文件名格式错误: ${latest_file}${NC}"
                echo -e "预期格式示例: 0.123_xp_1.bin"
                exit 1
            fi

            # 反向查找z_checkpoint中的行号
            if [ ! -f "z_checkpoint.txt" ]; then
                echo -e "${RED}错误: z_checkpoint文件不存在${NC}"
                exit 1
            fi

            # 精确匹配红移值（支持科学计数法）
            checkpoint=$(awk -v z="$z_value" -v tolerance=0.001 \
                'BEGIN{FS="[ \t]+"; target=z+0} 
                {current=$1+0; 
                if (current >= target - tolerance && current <= target + tolerance) {
                    print NR;
                }}' z_checkpoint.txt)

            if [ -z "$checkpoint" ]; then
                echo -e "${RED}错误: 未找到红移值 $z_value 对应的检查点${NC}"
                echo -e "${YELLOW}z_checkpoint 内容预览: "
                head -n 5 z_checkpoint.txt
                exit 1
            fi

            ls -ltr "$output/$opath/image1"/*_xp_1.bin | tail -4
            echo -e "   ${GREEN}建议检查点: ${CYAN}$checkpoint (z=$z_value)${NC}"
            while true; do
                read -p "使用该检查点？[Y使用/N退出]: " yn
                case $yn in
                    [Yy]* ) echo "继续执行..."; break;;
                    [Nn]* ) echo "退出脚本"; exit 1;;
                    * ) echo "请输入 Y 或 N";;
                esac
            done
        fi

        cd $rawpath
    fi


    info

    if [ "$all_yes" == false ]; then
        while true; do
            read -p "参数正确？[Yy/Nn]: " yn
            case $yn in
                [Yy]* ) echo "继续执行..."; break;;
                [Nn]* ) echo "退出脚本"; exit 1;;
                * ) echo "请输入 Y 或 N";;
            esac
        done
        echo ''
        echo ''
    fi
}


get_para "$@"

run_para_ini

make clean && cd utilities && make clean && cd ..

if [ "$RunIC" == true ] || [ "$RunMain" == true ]; then
    para_2_code
fi

if [ "$RUNtype" == "pbs" ]; then
    pbs_run
elif [ "$RUNtype" == "local" ]; then
    echo -e "${GREEN}当前工作目录: ${NC}$(pwd)"

    rm -v *.log


    # 输出运行信息
    if [ "$log_name" != "None" ]; then
        date > "$log_name"
        info >> "$log_name"
    fi

    # 运行IC生成
    if [ "$RunIC" == true ]; then
        cd utilities
        make clean
        make ic.x
        cd ..
        [ "$log_name" != "None" ] && echo "RunIC" >> "$log_name"
        local_run "./utilities/ic.x"

        if [ "$RunCIC" == true ]; then
            sed -i "s/\(cur_checkpoint=\) \([0-9]\+\),\([0-9]\+\)/\1 1,1/" utilities/cicpower.f90
            cd utilities
            make cicpower.x
            cd ..
            local_run "./utilities/cicpower.x"
        fi
    fi

    # 运行主程序
    if [ "$RunMain" == true ]; then
        make clean
        make 
        [ "$log_name" != "None" ] && echo "RunMain" >> "$log_name"
        local_run "time ./main.x"
        if [ "$RunCIC" == true ]; then
            sed -i "s/\(cur_checkpoint=\) \([0-9]\+\),\([0-9]\+\)/\1 $z1,$z2/" utilities/cicpower.f90
            cd utilities
            make cicpower.x
            cd ..
            local_run "./utilities/cicpower.x"
        fi
    fi  

    # 单独运行CIC
    if [ "$RunCIC" == true ] && [ "$RunMain" != true ] && [ "$RunIC" != true ] && [ "$Findhalo" != true ]; then
        sed -i "s/\(cur_checkpoint=\) \([0-9]\+\),\([0-9]\+\)/\1 $z1,$z2/" utilities/cicpower.f90
        cd utilities
        make cicpower.x
        cd ..
        [ "$log_name" != "None" ] && echo "CIC" >> "$log_name"
        local_run "./utilities/cicpower.x"
    fi

    if [ "$Findhalo" == true ]; then
        [ "$log_name" != "None" ] && echo "Findhalo" >> "$log_name"
        sed -i "s/\(cur_checkpoint=\) \([0-9]\+\),\([0-9]\+\)/\1 $z1,$z2/" utilities/fof.f90
        cd utilities
        make clean
        make fof.x
        cd ..
        local_run "./utilities/fof.x"
    fi


fi